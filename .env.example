# Copy this file to .env before using docker compose.
QWEN_PORT=7860

# Leave blank to generate a random administrator password in the data volume.
QWEN_ADMIN_PASSWORD=

# Optional. Prefer putting tokens in the data volume's tokens.txt file.
QWEN_HF_TOKENS=

# Optional. Prefer putting proxies in the data volume's proxies.txt file.
QWEN_PROXIES=

# Optional, comma-separated Hugging Face Space IDs with a compatible /generate API.
QWEN_SPACES=

QWEN_STRATEGY=token_first
QWEN_CONCURRENCY=1
